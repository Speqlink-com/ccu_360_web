# Vercel supports bulk import of these values. Do not put backend secrets here.
NEXT_PUBLIC_DEMO_MODE=false
# Server-side API gateway. Tokens remain in HttpOnly cookies.
API_PROXY_TARGET=https://api.ccu360.health
# Optional trusted-network observation: same server-only value as the backend.
# Never use a NEXT_PUBLIC_ prefix. Leave blank until both services are configured.
WORKSITE_PROXY_SECRET=
