{
  "name": "ccu_360_web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "dev:poll": "WATCHPACK_POLLING=true next dev --webpack",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:demo": "tsx scripts/smoke-demo.mts",
    "dev:preview": "CCU360_BUILD_DIR=.next-preview WATCHPACK_POLLING=true next dev --webpack --hostname 127.0.0.1 --port 3106",
    "demo:build": "NEXT_PUBLIC_DEMO_MODE=true CCU360_BUILD_DIR=.next-demo next build --turbopack",
    "demo:start": "CCU360_BUILD_DIR=.next-demo PORT=3106 node scripts/start.mjs",
    "prebuild": "node scripts/prepare-demo-session-key.mjs",
    "predemo:build": "node scripts/prepare-demo-session-key.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.106.1",
    "lucide-react": "1.69.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
